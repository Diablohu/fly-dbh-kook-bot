{
    "name": "fly-dbh-kook-bot",
    "version": "0.1.0",
    "description": "Kook bot for fly-dbh.com",
    "main": "./dist/app.cjs",
    "type": "module",
    "scripts": {
        "start": "npm run build && node ./dist/app.cjs",
        "build": "webpack",
        "pb": "node publish.js",
        "dev": "cross-env WEBPACK_BUILD_ENV=dev webpack",
        "test": "npx vitest __tests__/",
        "up": "npx npm-check-updates -i"
    },
    "private": true,
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Diablohu/fly-dbh-kook-bot.git"
    },
    "engines": {
        "node": ">=18.12.0"
    },
    "keywords": [
        "kook"
    ],
    "author": {
        "name": "Diablohu",
        "email": "diablohudream@gmail.com",
        "url": "http://diablohu.com"
    },
    "bugs": {
        "url": "https://github.com/Diablohu/fly-dbh-kook-bot/issues"
    },
    "homepage": "https://github.com/Diablohu/fly-dbh-kook-bot#readme",
    "dependencies": {
        "@koa/router": "^15.1.1",
        "axios": "^1.13.2",
        "dayjs": "^1.11.19",
        "debug": "^4.4.3",
        "dotenv": "^17.2.3",
        "form-data": "^4.0.5",
        "fs-extra": "^11.3.3",
        "koa": "^3.1.1",
        "koa-body": "^7.0.1",
        "koa-bodyparser": "^4.4.1",
        "koa-sendfile": "^3.0.0",
        "md5": "^2.3.0",
        "numeral": "^2.0.6",
        "supports-color": "^10.2.2",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@babel/core": "^7.28.5",
        "@babel/preset-typescript": "^7.28.5",
        "@types/debug": "^4.1.12",
        "@types/fs-extra": "^11.0.4",
        "@types/koa": "^3.0.1",
        "@types/koa-bodyparser": "^4.3.13",
        "@types/koa-router": "^7.4.9",
        "@types/listr": "^0.14.10",
        "@types/numeral": "^2.0.5",
        "@types/zen-observable": "^0.8.7",
        "babel-loader": "^10.0.0",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^13.0.1",
        "cross-env": "^10.1.0",
        "discord.js": "^14.25.1",
        "eslint": "^8.57.0",
        "eslint-config-koot": "^5.0.7",
        "husky": "^9.1.7",
        "koot-cli-kit": "^0.0.3",
        "lint-staged": "^16.2.7",
        "listr": "^0.14.3",
        "prettier": "^3.7.4",
        "prettier-eslint": "^16.4.2",
        "react": "^19.2.3",
        "thread-loader": "^4.0.4",
        "vitest": "^4.0.16",
        "webpack": "^5.104.1",
        "webpack-cli": "^6.0.1"
    },
    "overrides": {},
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.{js,jsx,cjs,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{xxxxxx}": [
            "tsc --noEmit"
        ],
        "*.{json,md,css,less,sass,scss}": [
            "prettier --write"
        ]
    }
}
